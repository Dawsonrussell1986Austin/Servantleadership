{
  "expo": {
    "name": "Servant",
    "slug": "servant-liturgies",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "servant",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBFAF7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servantleadership.liturgies",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.servantleadership.liturgies",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FBFAF7"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFAF7",
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#9C6B3F"
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "audioBaseUrl": "https://servant-liturgies.vercel.app",
      "userName": "Dawson",
      "revenueCatApiKeyIos": "",
      "revenueCatApiKeyAndroid": ""
    }
  }
}
